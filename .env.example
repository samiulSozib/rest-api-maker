# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# JWT Configuration
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here
JWT_ISSUER=rest-api-maker
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password_or_app_password

# Email Verification
REQUIRE_EMAIL_VERIFICATION=false
VERIFY_TOKEN_EXPIRY_HOURS=24

# API Token Configuration
API_TOKEN_HASH_ALGO=sha256

# Frontend URL
FRONTEND_URL=http://localhost:3001

# cPanel/Database Management (if using)
CPANEL_HOST=your_cpanel_host
CPANEL_USER=your_cpanel_username
CPANEL_API_TOKEN=your_cpanel_api_token
CPANEL_MYSQL_HOST=localhost
CPANEL_MYSQL_PORT=3306
CPANEL_MYSQL_ROOT_USER=root
CPANEL_MYSQL_ROOT_PASS=root_password

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./src/uploads
